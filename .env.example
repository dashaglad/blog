# Ports
POSTGRES_HOST_PORT=5432
POSTGRES_TEST_HOST_PORT=5433
REDIS_HOST_PORT=6379
APP_HOST_PORT=8000

# Postgres
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres
POSTGRES_DB=blog
DATABASE_URL=postgresql+psycopg2://postgres:postgres@db:5432/blog
POSTGRES_DB_TEST=blog_test
DATABASE_URL_TEST=postgresql+psycopg2://postgres:postgres@db_tests:5432/blog_test

# Redis
REDIS_URL=redis://redis:6379/0
REDIS_URL_TEST=redis://redis:6379/1

# Cache
CACHE_TTL=600
